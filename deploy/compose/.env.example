# Copy to .env (make infra-up does it for you). Local development values only.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

EVENT_DB_PASSWORD=event
BOOKING_DB_PASSWORD=booking
PAYMENT_DB_PASSWORD=payment

REDIS_PASSWORD=redis
REDIS_PORT=6379

KAFKA_EXTERNAL_PORT=19092
REDPANDA_CONSOLE_PORT=8085

EVENT_HTTP_PORT=8081
LOG_LEVEL=info

# Go module proxy used inside Docker builds. If proxy.golang.org is blocked, use:
# GOPROXY=https://goproxy.io,direct
GOPROXY=https://proxy.golang.org,direct
